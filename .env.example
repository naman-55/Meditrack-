# MediTrack v3.1 - Environment Configuration Template

# JSON Web Token Secret (Required for production authentication security)
# Generate a strong 256-bit random key: openssl rand -hex 32
JWT_SECRET="your-strong-random-jwt-secret-here"

# Allowed CORS Origins (comma-separated or empty for same-origin dev)
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Application Server Port (Defaults to 3000)
PORT="3000"

# Node Environment ('development' or 'production')
NODE_ENV="development"

# GEMINI_API_KEY: Required for Medical Report OCR biomarker extraction
# Get an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=""

# APP_URL: The URL where this application is hosted
APP_URL="http://localhost:3000"

# Password Reset Security Configuration
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=30
PASSWORD_RESET_RATE_LIMIT=3
FRONTEND_URL="http://localhost:3000"
EMAIL_PROVIDER="console"

# Google Maps Platform API Key (Optional; OpenStreetMap Leaflet serves as fallback)
GOOGLE_MAPS_API_KEY=""
VITE_GOOGLE_MAPS_API_KEY=""

