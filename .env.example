# MediTrack v3.1 - Environment Configuration Template

# JSON Web Token Secret (Required for production authentication security)
# Generate a strong 256-bit random key: openssl rand -hex 32
JWT_SECRET="your-strong-random-jwt-secret-here"

# Allowed CORS Origins (comma-separated or empty for same-origin dev)
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Application Server Port (Defaults to 3000)
PORT="3000"

# Node Environment ('development' or 'production')
NODE_ENV="development"

# GEMINI_API_KEY: Required for Medical Report OCR biomarker extraction
# Get an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=""

# APP_URL: The URL where this application is hosted
APP_URL="http://localhost:3000"

# Password Reset Security Configuration
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=30
PASSWORD_RESET_RATE_LIMIT=3
FRONTEND_URL="http://localhost:3000"
# Notification Delivery Providers
# Email Delivery: Official Google Gmail API v1 (Google OAuth 2.0)
NOTIFICATION_MODE="gmail-and-telegram"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/notifications/gmail/callback"

# Telegram Bot Notifications (Official Telegram Bot API - Replaces SMS)
# Obtain token by messaging @BotFather on Telegram: /newbot
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_WEBHOOK_SECRET=""

# Browser Web Push Notifications (VAPID)
# Generated keys for secure RFC 8292 push notifications
VAPID_PUBLIC_KEY="BLIBxJOLLsQgUWbPBZ_wN57YKWusriSo9vH5uI3n4JPq2BttdjuUuhn8Lelm6EUhzc39oASBMTqNQP3qDtch6G0"
VAPID_PRIVATE_KEY="0bZT9N8NwIMcLipvYogo0vJIqrLR0AQqiGluRqXORNo"
VAPID_SUBJECT="mailto:support@meditrack.health"

# Google Maps Platform API Key (Optional; OpenStreetMap Leaflet serves as fallback)
GOOGLE_MAPS_API_KEY=""
VITE_GOOGLE_MAPS_API_KEY=""

