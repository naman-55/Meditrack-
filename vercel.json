{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js?__path=$1"
    },
    {
      "source": "/((?!assets/|favicon\\.svg|logo\\.svg).*)",
      "destination": "/index.html"
    }
  ]
}
